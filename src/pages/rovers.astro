---
import BaseLayout from '@/layouts/BaseLayout.astro';
import roverInfo from '@/data/roverInfo.json';
import { RoversScene } from '@/components/rovers/RoversScene';

const reversedRovers = [...roverInfo];
const featuredRovers = reversedRovers.slice(0, 3);
const gridRovers = reversedRovers.slice(3);
---

<BaseLayout title="Rovers - University of Michigan Mars Rover Team" description="Explore MRover's history of Mars rovers from 2000 to 2026, including competition results and engineering innovations at the University Rover Challenge." image="https://mrover.org/roverImages/2026/PHIL.webp">
  <RoversScene client:only="react" />

  <main id="main-content" class="relative z-10 min-h-screen w-full overflow-x-hidden font-sans">
    <section class="max-w-[1400px] mx-auto px-8 pt-24 pb-16 flex flex-col gap-12">
      <div class="text-center pb-8">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold uppercase text-white mb-4" style="font-family: 'Panchang', sans-serif; text-shadow: 0 0 30px rgba(255, 140, 0, 0.3);">
          Our Rovers
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-white/60 uppercase tracking-[0.2em]">
          A history of innovation and exploration
        </p>
      </div>
      {featuredRovers.map((rover, index) => (
        <a
          href="#content"
          id={rover.year}
          data-year={rover.year}
          data-name={rover.name}
          data-image={rover.image_path}
          data-desc={JSON.stringify(rover.desc)}
          data-slides={JSON.stringify(rover.slideshow)}
          class={`featured-card group flex flex-col h-auto lg:flex-row lg:h-[400px] bg-[#0e0e0e]/60 border border-white/10 rounded-lg overflow-hidden no-underline backdrop-blur-sm cursor-pointer transition-all duration-300 hover:-translate-y-1 hover:border-mrover-accent hover:shadow-card-hover ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}
        >
          <div class="h-[250px] lg:h-auto lg:flex-[1.2] overflow-hidden relative">
            <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style={`background-image: url('/${rover.image_path}');`}></div>
          </div>

          <div class={`p-8 lg:p-12 lg:flex-[0.8] flex flex-col justify-center ${index % 2 === 1 ? 'lg:border-r lg:border-white/5' : 'lg:border-l lg:border-white/5'}`}>
            <h3 class="text-3xl lg:text-5xl font-bold text-white leading-none m-0" style="font-family: 'Panchang', sans-serif;">{rover.year}</h3>
            <p class="text-2xl text-mrover-accent uppercase tracking-[0.15em] font-semibold mt-2 mb-6">{rover.name}</p>
            <div class="text-lg leading-relaxed text-white/70 mb-6">
              <p class="m-0">{rover.desc[0].substring(0, 150)}...</p>
            </div>
            <span class="inline-flex items-center text-white font-medium uppercase tracking-widest text-sm opacity-80 transition-all duration-300 group-hover:text-mrover-accent group-hover:opacity-100 group-hover:pl-2.5">
              Read More &rarr;
            </span>
          </div>
        </a>
      ))}
    </section>

    <section class="max-w-[1400px] mx-auto px-8 pb-16">
      <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-8">
        {gridRovers.map(rover => (
          <a
            href="#content"
            id={rover.year}
            data-year={rover.year}
            data-name={rover.name}
            data-image={rover.image_path}
            data-desc={JSON.stringify(rover.desc)}
            data-slides={JSON.stringify(rover.slideshow)}
            class="rover-card group block relative aspect-4/3 rounded overflow-hidden border border-white/10 bg-[#0e0e0e]/40 backdrop-blur-sm no-underline cursor-pointer transition-all duration-300 hover:-translate-y-2 hover:border-mrover-accent hover:shadow-[0_20px_40px_rgba(0,0,0,0.4),0_0_20px_rgba(255,140,0,0.2)]"
          >
            <div class="w-full h-full bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style={`background-image: url('/${rover.image_path}');`}></div>

            <div class="absolute inset-0 bg-linear-to-t from-black/95 via-black/50 to-transparent flex flex-col justify-end p-6 transition-all duration-300 group-hover:from-black/95 group-hover:via-black/60 group-hover:to-black/20">
              <h3 class="text-4xl font-semibold text-white m-0 leading-none" style="font-family: 'Panchang', sans-serif;">{rover.year}</h3>
              <p class="text-lg text-mrover-accent mt-2 font-medium tracking-widest uppercase opacity-80 transition-opacity duration-300 group-hover:opacity-100">{rover.name}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <div id="rover-modal" class="modal-overlay hidden fixed inset-0 z-100 flex items-center justify-center p-8 overflow-hidden">
    <div class="modal-backdrop absolute inset-0 bg-black/85 opacity-0 transition-opacity duration-300"></div>
    <div class="modal-container relative max-w-content max-h-[90vh] w-full bg-[#0a0a0a]/95 backdrop-blur-2xl border border-white/10 border-l-4 border-l-mrover-accent rounded-lg shadow-[0_30px_60px_rgba(0,0,0,0.5)] opacity-0 scale-95 translate-y-5 transition-all duration-300 overflow-y-auto overscroll-contain" data-lenis-prevent>
      <div class="p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
          <div>
            <div id="content-title"></div>
            <div id="content-text" class="prose-content"></div>
          </div>
          <div class="relative rounded-lg overflow-hidden border border-white/10">
            <div id="content-slideshow" class="w-full block"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    let slideIndex = 0;
    let modalLenis = null;

    function showSlides(n) {
      const slides = document.querySelectorAll('#content-slideshow .slide');
      if (!slides.length) return;

      if (n >= slides.length) { slideIndex = 0; }
      else if (n < 0) { slideIndex = slides.length - 1; }
      else { slideIndex = n; }

      slides.forEach((slide) => {
        slide.style.display = 'none';
      });
      slides[slideIndex].style.display = 'block';
    }

    window.plusSlides = function(n) {
      showSlides(slideIndex + n);
    }

    function openModal() {
      const modal = document.getElementById('rover-modal');
      const container = modal.querySelector('.modal-container');
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      document.body.style.paddingRight = scrollbarWidth + 'px';
      if (window.__lenis) window.__lenis.stop();

      container.scrollTop = 0;
      modalLenis = new window.__Lenis({
        wrapper: container,
        content: container.firstElementChild,
        duration: 0.8,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });
      function modalRaf(time) {
        modalLenis.raf(time);
        if (modalLenis) requestAnimationFrame(modalRaf);
      }
      requestAnimationFrame(modalRaf);

      requestAnimationFrame(() => {
        modal.classList.add('visible');
      });
    }

    function closeModal() {
      const modal = document.getElementById('rover-modal');
      modal.classList.remove('visible');
      if (modalLenis) {
        modalLenis.destroy();
        modalLenis = null;
      }
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
        if (window.__lenis) window.__lenis.start();
      }, 300);
    }

    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('rover-modal');
      const backdrop = modal.querySelector('.modal-backdrop');

      backdrop.addEventListener('click', closeModal);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });

      document.querySelectorAll('a[href="#content"][id]').forEach(tile => {
        tile.addEventListener('click', function(event) {
          event.preventDefault();

          const year = this.dataset.year;
          const name = this.dataset.name;
          const descArray = JSON.parse(this.dataset.desc || '[]');
          const slidesArray = JSON.parse(this.dataset.slides || '[]');

          const contentTitle = document.getElementById('content-title');
          contentTitle.textContent = '';
          const h2 = document.createElement('h2');
          h2.className = 'text-3xl md:text-4xl lg:text-5xl font-semibold text-white mb-8 leading-tight';
          h2.style.fontFamily = "'Panchang', sans-serif";
          h2.append(
            year + ' ',
            Object.assign(document.createElement('span'), { className: 'text-mrover-accent mx-2', textContent: '//' }),
            ' ' + name
          );
          contentTitle.appendChild(h2);

          const contentText = document.getElementById('content-text');
          contentText.textContent = '';
          descArray.forEach(desc => {
            const p = document.createElement('p');
            p.className = 'text-lg leading-relaxed text-white/85 mb-6 font-light';
            p.textContent = desc;
            contentText.appendChild(p);
          });

          const contentSlideshow = document.getElementById('content-slideshow');
          contentSlideshow.textContent = '';

          if (slidesArray.length > 0) {
            slidesArray.forEach(slide => {
              const img = document.createElement('img');
              img.className = 'slide w-full animate-fade';
              img.src = '/' + slide;
              img.alt = name + ' rover ' + year;
              contentSlideshow.appendChild(img);
            });

            if (slidesArray.length > 1) {
              const prev = document.createElement('a');
              prev.className = 'prev absolute top-1/2 left-0 -mt-5 p-4 text-white font-bold text-2xl bg-black/50 cursor-pointer select-none z-10 rounded-r transition-colors hover:bg-mrover-accent';
              prev.textContent = '\u276E';
              prev.addEventListener('click', () => plusSlides(-1));
              contentSlideshow.appendChild(prev);

              const next = document.createElement('a');
              next.className = 'next absolute top-1/2 right-0 -mt-5 p-4 text-white font-bold text-2xl bg-black/50 cursor-pointer select-none z-10 rounded-l transition-colors hover:bg-mrover-accent';
              next.textContent = '\u276F';
              next.addEventListener('click', () => plusSlides(1));
              contentSlideshow.appendChild(next);
            }

            slideIndex = 0;
            showSlides(0);
          }

          openModal();
        });
      });
    });
  </script>

  <style>
    .modal-overlay.visible .modal-backdrop {
      opacity: 1;
    }

    .modal-overlay.visible .modal-container {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    .slide {
      display: none;
    }
  </style>
</BaseLayout>
