---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { AboutPage } from '@/components/about/AboutPage'
---

<BaseLayout
  title="About - University of Michigan Mars Rover Team"
  description="Meet the subteams behind MRover: Mechanical, Science, Electrical, and Software."
  darkPage={true}
  showFooter={true}
>
  <div class="min-h-screen">
    <AboutPage client:only="react" />
  </div>
</BaseLayout>

<style is:global>
  .about-hero-title {
    opacity: 0;
    animation: about-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  .about-hero-sub {
    opacity: 0;
    animation: about-fade-up 0.7s ease 0.9s forwards;
  }

  @keyframes about-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
